---
const technologies = [
  { name: "AWS", category: "Cloud" },
  { name: "Cloudflare", category: "CDN / DNS" },
  { name: "Kubernetes", category: "Orquestación" },
  { name: "Docker", category: "Contenedores" },
  { name: "GitHub Actions", category: "CI/CD" },
  { name: "PostgreSQL", category: "Bases de datos" },
  { name: "CI/CD", category: "Pipelines" },
  { name: "Infrastructure as Code", category: "Terraform / IaC" },
  { name: "Monitoring & Observability", category: "Prometheus / Grafana" },
];
---

<section class="experience" id="experiencia">
  <div class="container">
    <div class="section-header centered">
      <span class="section-label">Experiencia</span>
      <h2 class="section-title">Experiencia real en Cloud &amp; DevOps</h2>
      <p class="section-subtitle">
        Experiencia trabajando con infraestructura Cloud, Kubernetes, Docker, CI/CD, bases de datos, monitoreo, automatización y migraciones de infraestructura.
      </p>
    </div>

    <div class="tech-grid">
      {technologies.map((tech) => (
        <div class="tech-badge">
          <span class="tech-name">{tech.name}</span>
          <span class="tech-category">{tech.category}</span>
        </div>
      ))}
    </div>

    <div class="experience-note">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
      </svg>
      <p>
        Trabajamos 100% de forma remota con empresas, startups y equipos de desarrollo que necesitan apoyo con infraestructura Cloud y DevOps.
      </p>
    </div>
  </div>
</section>

<style>
  .tech-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    margin-bottom: 3rem;
  }

  .tech-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.5rem;
    min-width: 120px;
    text-align: center;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .tech-badge:hover {
    border-color: rgba(59, 130, 246, 0.4);
    transform: translateY(-2px);
  }

  .tech-name {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .tech-category {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .experience-note {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    max-width: 600px;
    margin-inline: auto;
    background: rgba(59, 130, 246, 0.05);
    border: 1px solid rgba(59, 130, 246, 0.15);
    border-radius: var(--radius);
    padding: 1.25rem;
  }

  .experience-note svg {
    flex-shrink: 0;
    color: var(--accent-light);
    margin-top: 0.125rem;
  }

  .experience-note p {
    font-size: 0.9375rem;
    line-height: 1.6;
  }
</style>
