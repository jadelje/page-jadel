---
import { whatsappLink } from '../utils/whatsapp';

const services = [
  {
    title: "Diagnóstico Cloud",
    price: "Desde $250.000 COP",
    description: "Revisión completa de tu infraestructura (AWS / VPS / Cloudflare): seguridad básica, disponibilidad, backups, costos, configuraciones críticas y oportunidades de optimización.",
    deliverable: "Informe con problemas encontrados, nivel de prioridad y recomendaciones.",
    cta: "Solicitar diagnóstico",
    ctaHref: "#contacto",
    isWA: false,
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>`,
    featured: false,
  },
  {
    title: "Backup Empresarial",
    price: "Desde $400.000 COP",
    description: "Backups automatizados con almacenamiento externo, políticas de retención, cifrado, monitoreo, alertas y pruebas de restauración para proteger tu información crítica.",
    deliverable: null,
    cta: "Proteger mi información",
    ctaHref: null,
    isWA: true,
    ctaMessage: "Hola, vi la página de Cloud & DevOps y quisiera consultar sobre Backup Empresarial.",
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
    featured: false,
  },
  {
    title: "DevOps bajo demanda",
    price: "Desde $400.000 COP/mes",
    description: "La alternativa a contratar un DevOps de tiempo completo. CI/CD, GitHub Actions, AWS, Docker, Kubernetes, Cloudflare, infraestructura, monitoreo, despliegues, automatización y migraciones.",
    deliverable: null,
    cta: "Hablar con un especialista",
    ctaHref: null,
    isWA: true,
    ctaMessage: "Hola, vi la página de Cloud & DevOps y quisiera consultar sobre DevOps bajo demanda.",
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`,
    featured: true,
  },
];
---

<section class="services" id="servicios">
  <div class="container">
    <div class="section-header centered">
      <span class="section-label">Servicios</span>
      <h2 class="section-title">¿En qué podemos ayudarte?</h2>
      <p class="section-subtitle">
        Soluciones Cloud y DevOps pensadas para empresas que quieren escalar sin depender de un equipo interno de infraestructura.
      </p>
    </div>

    <div class="services-grid">
      {services.map((service) => (
        <article class={`service-card ${service.featured ? 'service-card--featured' : ''}`}>
          {service.featured && <div class="featured-badge">Más popular</div>}
          <div class="service-icon" aria-hidden="true" set:html={service.icon}></div>
          <h3 class="service-title">{service.title}</h3>
          <p class="service-price">{service.price}</p>
          <p class="service-description">{service.description}</p>
          {service.deliverable && (
            <div class="service-deliverable">
              <span class="deliverable-label">Entregable:</span>
              <span>{service.deliverable}</span>
            </div>
          )}
          <div class="service-cta">
            {service.isWA ? (
              <a
                href={whatsappLink(service.ctaMessage)}
                class="btn btn-primary"
                target="_blank"
                rel="noopener noreferrer"
              >
                {service.cta}
              </a>
            ) : (
              <a href={service.ctaHref} class="btn btn-primary">
                {service.cta}
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .services-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    .services-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .service-card {
    position: relative;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .service-card:hover {
    border-color: rgba(59, 130, 246, 0.4);
    box-shadow: 0 0 28px rgba(59, 130, 246, 0.1);
  }

  .service-card--featured {
    border-color: rgba(59, 130, 246, 0.5);
    background: var(--bg-card-hover);
  }

  .featured-badge {
    position: absolute;
    top: -0.75rem;
    left: 50%;
    transform: translateX(-50%);
    background: var(--accent);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.875rem;
    border-radius: 2rem;
    white-space: nowrap;
  }

  .service-icon {
    color: var(--accent-light);
    width: 2.5rem;
    height: 2.5rem;
  }

  .service-title {
    font-size: 1.25rem;
    color: var(--text-primary);
  }

  .service-price {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--accent-cyan);
  }

  .service-description {
    font-size: 0.9375rem;
    line-height: 1.6;
    flex: 1;
  }

  .service-deliverable {
    font-size: 0.875rem;
    color: var(--text-secondary);
    padding: 0.75rem;
    background: rgba(59, 130, 246, 0.05);
    border: 1px solid rgba(59, 130, 246, 0.15);
    border-radius: var(--radius-sm);
    line-height: 1.5;
  }

  .deliverable-label {
    font-weight: 600;
    color: var(--accent-light);
    margin-right: 0.25rem;
  }

  .service-cta {
    margin-top: auto;
  }

  .service-cta .btn {
    width: 100%;
    justify-content: center;
  }
</style>
